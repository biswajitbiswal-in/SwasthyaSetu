# ==============================================================================
# SWASTHYA SETU — SERVER ENVIRONMENT TEMPLATE (.env.example)
# Copy to .env and configure for your environment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
SESSION_SECRET=your_long_random_session_secret_change_in_production
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
JWT_SECRET=your_jwt_signing_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# 3. POSTGRESQL DATABASE & PERSISTENCE
# ------------------------------------------------------------------------------
# Connection string: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/swasthya_setu
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=3000

# ------------------------------------------------------------------------------
# 4. WEBRTC & NAT TRAVERSAL (STUN / TURN RELAY)
# ------------------------------------------------------------------------------
# Google public STUN server for local NAT discovery
STUN_URL=stun:stun.l.google.com:19302

# Optional TURN Relay credentials (for strict symmetric / CGNAT connections)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ------------------------------------------------------------------------------
# 5. TELEMETRY, LOGGING & NETWORK SENTINEL
# ------------------------------------------------------------------------------
LOG_LEVEL=debug
HEARTBEAT_INTERVAL_MS=10000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
