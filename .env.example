# ==============================================================================
# SWASTHYA SETU — MONOREPO ENVIRONMENT OVERVIEW (.env.example)
# Low-Network Telemedicine Platform for Rural Healthcare
# ==============================================================================
#
# This project is split into two packages:
#   1. server/  — Node.js / Express / PostgreSQL / WebSocket Gateway
#   2. client/  — Vite / React 19 / Tailwind / PWA Offline Service Worker
#
# ------------------------------------------------------------------------------
# SERVER ENVIRONMENT VARIABLES (placed in server/.env)
# ------------------------------------------------------------------------------
# NODE_ENV=development
# PORT=5000
# CLIENT_ORIGIN=http://localhost:5173
# SESSION_SECRET=swasthya_setu_session_secret_change_in_production
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/swasthya_setu
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT_MS=30000
# DB_CONNECTION_TIMEOUT_MS=3000
# STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=
# TURN_USERNAME=
# TURN_CREDENTIAL=
# LOG_LEVEL=debug
#
# ------------------------------------------------------------------------------
# CLIENT ENVIRONMENT VARIABLES (placed in client/.env)
# ------------------------------------------------------------------------------
# VITE_API_URL=/api/v1
# VITE_WS_URL=ws://localhost:5000/ws
# VITE_APP_NAME="Swasthya Setu"
# VITE_APP_TAGLINE="Bridge to Health"
# VITE_DEFAULT_LANGUAGE=en
# VITE_ENABLE_NETWORK_SIMULATOR=true
# VITE_LOW_BANDWIDTH_THRESHOLD_KBPS=50
# VITE_PACKET_LOSS_STEPDOWN_PERCENT=15
